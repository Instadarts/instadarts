# Local build and archive output. GitHub Releases contain a source snapshot, so neither generated
# client files nor release archives belong in the repository.
dist
release

# A deployment's own settings, under either accepted name. The committed file is
# instadarts.config.example.jsonc.
instadarts.config.jsonc
instadarts.config.json

# The certificate the server makes for itself when https is on and none is configured. Belongs to
# the machine that generated it, and naming the machine's addresses is the whole point of it.
instadarts-selfsigned.pem
instadarts-selfsigned.key

#logs
*.log
