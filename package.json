{
  "name": "instadarts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production node --import tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "lsof -ti:3000 -ti:5173 | xargs kill -9 2>/dev/null; sleep 1; npm run dev & sleep 3; npx playwright test; lsof -ti:3000 -ti:5173 | xargs kill -9 2>/dev/null"
  },
  "dependencies": {
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
